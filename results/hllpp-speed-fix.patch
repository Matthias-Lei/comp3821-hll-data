+bool HyperLogLogPlusPlus::dominated_by_compressed(std::uint32_t entry)
+{
+        if (!compressed_best_ready_) {
+                compressed_best_.clear();
+                std::size_t offset = 0;
+                std::uint32_t previous_entry = 0;
+                while (offset < compressed_sparse_.size()) {
+                        previous_entry += decode_varint(compressed_sparse_, offset);
+                        const std::uint32_t prefix = (previous_entry & 1)
+                            ? previous_entry >> kSparseRankShift : previous_entry >> 1;
+                        auto [it, inserted] = compressed_best_.emplace(prefix, previous_entry);
+                        if (!inserted && (previous_entry & 1)
+                            && ((previous_entry >> 1) & kRankMask) > ((it->second >> 1) & kRankMask)) {
+                                it->second = previous_entry;
+                        }
+                }
+                compressed_best_ready_ = true;
+        }
+        const std::uint32_t prefix = (entry & 1) ? entry >> kSparseRankShift : entry >> 1;
+        const auto found = compressed_best_.find(prefix);
+        if (found == compressed_best_.end()) {
+                return false;
+        }
+        return !((entry & 1) && (found->second & 1)
+            && ((entry >> 1) & kRankMask) > ((found->second >> 1) & kRankMask));
+}
